{
  "name": "jingwei-agent-runtime-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "biome check packages testdata",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test packages",
    "test:coverage": "bun test --coverage packages",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/bun": "^1.2.21",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
