{
  "$defs": {
    "ExecutionId": {
      "description": "Opaque `ExecutionId` wire identifier.",
      "type": "string"
    },
    "IdempotencyKey": {
      "description": "Opaque `IdempotencyKey` wire identifier.",
      "type": "string"
    },
    "ProjectId": {
      "description": "Opaque `ProjectId` wire identifier.",
      "type": "string"
    },
    "RequestId": {
      "description": "Opaque `RequestId` wire identifier.",
      "type": "string"
    },
    "RevisionId": {
      "description": "Opaque `RevisionId` wire identifier.",
      "type": "string"
    },
    "TaskId": {
      "description": "Opaque `TaskId` wire identifier.",
      "type": "string"
    },
    "TraceContext": {
      "description": "W3C-compatible trace parent carried across the TypeScript/Rust JDP boundary.",
      "properties": {
        "spanId": {
          "type": "string"
        },
        "traceFlags": {
          "default": 1,
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "traceId",
        "spanId"
      ],
      "type": "object"
    },
    "WorkspaceId": {
      "description": "Opaque `WorkspaceId` wire identifier.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Versioned JDP request envelope.",
  "properties": {
    "baseRevision": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "deadlineMs": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "dryRun": {
      "default": false,
      "type": "boolean"
    },
    "executionId": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotencyKey": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "input": true,
    "operation": {
      "type": "string"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectId"
    },
    "protocolVersion": {
      "type": "string"
    },
    "requestId": {
      "$ref": "#/$defs/RequestId"
    },
    "taskId": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskId"
        },
        {
          "type": "null"
        }
      ]
    },
    "traceContext": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspaceId": {
      "$ref": "#/$defs/WorkspaceId"
    }
  },
  "required": [
    "protocolVersion",
    "requestId",
    "idempotencyKey",
    "workspaceId",
    "projectId",
    "operation",
    "input"
  ],
  "title": "JdpRequest",
  "type": "object"
}
